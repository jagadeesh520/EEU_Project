  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "target": "esnext",
    "module": "esnext",
    "jsx": "react-native",
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
